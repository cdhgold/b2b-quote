#!/bin/bash
# /usr/local/bin/app-deploy-gate  (owner root, 755)
# deploy 계정 authorized_keys 의 강제 명령:
#   command="/usr/local/bin/app-deploy-gate",restrict ssh-ed25519 AAAA... github-actions-deploy
# 허용 명령 (SSH_ORIGINAL_COMMAND):
#   deploy <sha256> <git-rev>   stdin 으로 JAR 수신 → 루트 배포 스크립트 호출
#   rollback                    직전 릴리스로 되돌림
#   status                      현재/직전 릴리스와 헬스 확인
set -euo pipefail
umask 077

INCOMING=/var/lib/app/incoming
MAX_BYTES=$((200 * 1024 * 1024))
cmd="${SSH_ORIGINAL_COMMAND:-}"

if [[ "$cmd" =~ ^deploy\ ([0-9a-f]{64})\ ([0-9a-f]{7,40})$ ]]; then
    sha="${BASH_REMATCH[1]}"
    rev="${BASH_REMATCH[2]}"
    part="$INCOMING/$sha.jar.part"
    head -c "$((MAX_BYTES + 1))" > "$part"
    if [ "$(stat -c %s "$part")" -gt "$MAX_BYTES" ]; then
        rm -f "$part"
        echo "rejected: JAR too large" >&2
        exit 3
    fi
    mv -f "$part" "$INCOMING/$sha.jar"
    exec sudo -n /usr/local/sbin/app-deploy deploy "$sha" "$rev"
elif [ "$cmd" = "rollback" ]; then
    exec sudo -n /usr/local/sbin/app-deploy rollback
elif [ "$cmd" = "status" ]; then
    exec sudo -n /usr/local/sbin/app-deploy status
else
    logger -t app-deploy-gate -p auth.warning "denied command from ${SSH_CLIENT:-local}"
    echo "denied" >&2
    exit 2
fi
